# Modelo de variáveis de ambiente do Explora+.
# Copie este arquivo para .env e preencha os valores reais:
#   cp .env.example .env

# --- Autenticação / Sessão ---
JWT_SECRET=

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Banco de dados ---
# Deixe em branco para usar o caminho absoluto padrão do código
# (dist/database/database.sqlite). Se preencher, use um CAMINHO
# ABSOLUTO — um caminho relativo quebra dependendo de onde o
# processo for iniciado ("unable to open database file").
DATABASE_PATH=

# --- E-mail (SMTP) ---
# Deixe SMTP_HOST vazio para rodar em modo simulado (códigos aparecem no terminal).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=nao-responda@explora.app
