PORTA=3000
JWT_SECRET=troque-este-segredo-em-producao
COOKIE_SECRET=troque-este-outro-segredo-em-producao

# RN-023 — CORS restritivo: lista de origens externas autorizadas a chamar
# a API, separadas por vírgula. Requisições same-origin sempre funcionam.
ALLOWED_ORIGINS=http://localhost:3000

# RN-051/052/006/009 — envio real de e-mail (nodemailer). Sem SMTP_HOST
# configurado, o sistema cai em "modo dev": loga o conteúdo no console em
# vez de enviar de verdade (cadastro, recuperação de senha, cancelamentos).
# SMTP_HOST=smtp.seuservidor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario@seuservidor.com
# SMTP_PASS=sua-senha
# SMTP_FROM=nao-responda@explora.app

# RN-028 — HTTPS/TLS nativo (opcional). Se não definidos, o servidor sobe em
# HTTP simples — recomendado rodar por trás de um proxy que já termina TLS.
# HTTPS_CERT_PATH=/caminho/para/cert.pem
# HTTPS_KEY_PATH=/caminho/para/key.pem

# Opcional — se não definido, o banco é criado em dist/database/database.sqlite
# DATABASE_PATH=./dados/database.sqlite
