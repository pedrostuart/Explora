{
  "$schema": "https://schemastore.org",
  "collection": "@nestjs/schematics",
  "sourceRoot": "backend",
  "entryFile": "main",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "database/schema.sql", "outDir": "dist" },
      { "include": "views/**/*", "outDir": "dist" }
    ]
  }
}
