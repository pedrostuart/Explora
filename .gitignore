# --- Dependências ---
node_modules/

# --- Build (dist/) ---
# Ignora tudo dentro de dist/, EXCETO dist/database/database.sqlite.
# Motivo: este projeto não cria as tabelas via código (não há CREATE TABLE
# no backend) — o schema inteiro vive dentro desse arquivo .sqlite. Se ele
# fosse ignorado, um "git clone" novo subiria sem nenhuma tabela no banco.
dist/*
!dist/database/
dist/database/*
!dist/database/database.sqlite
build/

# --- Variáveis de ambiente ---
.env
.env.local
.env.*.local

# --- Outros bancos SQLite locais (fora do schema versionado acima) ---
*.sqlite-journal
*.sqlite3
*.db

# --- Uploads de usuário (mantém a estrutura de pastas, ignora o conteúdo) ---
uploads/**
!uploads/
!uploads/*/
!uploads/**/.gitkeep

# --- Logs ---
*.log
npm-debug.log*
logs/

# --- Cobertura de testes ---
coverage/
.nyc_output/

# --- Editores / IDEs ---
.vscode/
.idea/
*.swp
*.swo

# --- Sistema operacional ---
.DS_Store
Thumbs.db

# --- Diversos ---
*.tsbuildinfo
.npm/
.cache/
